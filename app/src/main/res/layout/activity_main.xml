<?xml version="1.0" encoding="utf-8"?>
<!-- Empire Rewards — single-activity UI.
     Four screens (Home / Walk / Receipts / Rewards) toggled by the bottom
     nav, plus a full-screen test-ad overlay. Every view carries
     layout_width AND layout_height (aapt2 does not check this; a missing
     one crashes at setContentView on device). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/black_card"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EMPIRE REWARDS"
            android:textColor="@color/gold_bright"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 pts"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Account bar: who is signed in + sign out. Visible with the main UI. -->
    <LinearLayout
        android:id="@+id/accountBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header"
        android:background="@color/black_card"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/accountLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Guest — points stay on this phone"
            android:textColor="@color/grey_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSignOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/black_card"
            android:text="Sign out"
            android:textColor="@color/gold_bright"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Screens -->
    <FrameLayout
        android:id="@+id/screenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bannerContainer"
        android:layout_below="@+id/accountBar">

        <!-- HOME -->
        <ScrollView
            android:id="@+id/screenHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's steps"
                    android:textColor="@color/grey_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/stepsHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressHome"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progress="0" />

                <TextView
                    android:id="@+id/stepsToBoxHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Walk 1,000 steps to unlock a Loot Box"
                    android:textColor="@color/grey_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Points balance"
                    android:textColor="@color/grey_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/pointsHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 pts"
                    android:textColor="@color/gold_bright"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/boxesHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 Loot Boxes waiting to open"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnLucky"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@color/gold"
                    android:text="Open Daily Lucky Box"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAdPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/black_card"
                    android:text="Watch ad  +50 pts"
                    android:textColor="@color/gold_bright"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnAdBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/black_card"
                    android:text="Watch ad for an extra Loot Box"
                    android:textColor="@color/gold_bright"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Recent activity"
                    android:textColor="@color/grey_text"
                    android:textSize="16sp" />

                <ListView
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/black_card" />
            </LinearLayout>
        </ScrollView>

        <!-- WALK -->
        <ScrollView
            android:id="@+id/screenWalk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Walk to earn"
                    android:textColor="@color/gold_bright"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stepsWalk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="0 steps today"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressWalk"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progress="0" />

                <TextView
                    android:id="@+id/stepsToBoxWalk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1,000 steps = 1 Loot Box · max 3 per day"
                    android:textColor="@color/grey_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/sensorStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Step counter starting…"
                    android:textColor="@color/grey_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Your Loot Boxes — tap to open"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/box0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/black_card"
                    android:text="Box 1 — Locked"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/box1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/black_card"
                    android:text="Box 2 — Locked"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/box2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/black_card"
                    android:text="Box 3 — Locked"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Bonus boxes (from ads)"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/bonusBoxRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/noBonusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No bonus boxes yet — watch an ad from Home to earn one."
                        android:textColor="@color/grey_text"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- RECEIPTS -->
        <ScrollView
            android:id="@+id/screenReceipts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receipt rewards"
                    android:textColor="@color/gold_bright"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Snap a photo of any shopping receipt. 50 pts per receipt, max 3 per day. Receipts are marked “Pending review” — v1 has no verification backend yet, so points are awarded on submission and nothing here claims a human or system checked your receipt."
                    android:textColor="@color/grey_text"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnSnap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/gold"
                    android:text="Snap a receipt"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/receiptsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Receipts today: 0 / 3"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/receiptThumb"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/black_card"
                    android:contentDescription="Last receipt photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Receipt history"
                    android:textColor="@color/grey_text"
                    android:textSize="16sp" />

                <ListView
                    android:id="@+id/receiptHistoryList"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/black_card" />
            </LinearLayout>
        </ScrollView>

        <!-- REWARDS -->
        <ScrollView
            android:id="@+id/screenRewards"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redeem gift cards"
                    android:textColor="@color/gold_bright"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pointsRewards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Your balance: 0 pts"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1,000 pts = $1"
                    android:textColor="@color/grey_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Redeeming opens at 1,000 points. Every point counts toward it — walking, ads, receipts and the Lucky Box all go into the same balance."
                    android:textColor="@color/grey_text"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/black_card"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$1 gift card — 1,000 pts"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/redeem1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/gold"
                        android:text="Redeem"
                        android:textColor="#111111" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/black_card"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$5 gift card — 5,000 pts"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/redeem5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/gold"
                        android:text="Redeem"
                        android:textColor="#111111" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/black_card"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$10 gift card — 10,000 pts"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/redeem10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/gold"
                        android:text="Redeem"
                        android:textColor="#111111" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/black_card"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$20 gift card — 20,000 pts"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/redeem20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/gold"
                        android:text="Redeem"
                        android:textColor="#111111" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/black_card"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$15 gift card — 15,000 pts"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/redeem15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/gold"
                        android:text="Redeem"
                        android:textColor="#111111" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/black_card"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$50 gift card — 50,000 pts"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/redeem50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/gold"
                        android:text="Redeem"
                        android:textColor="#111111" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/black_card"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$100 gift card — 100,000 pts"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/redeem100"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/gold"
                        android:text="Redeem"
                        android:textColor="#111111" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Tapping Redeem lets you pick the gift-card brand, then saves your request on this phone only. Requests are reviewed and paid from ad revenue — the app never promises an instant payout or an instant code. You must be signed in to redeem."
                    android:textColor="@color/grey_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="My redemption requests"
                    android:textColor="@color/grey_text"
                    android:textSize="16sp" />

                <ListView
                    android:id="@+id/redemptionList"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/black_card" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Banner ad (Unity, 320x50) — reserved space at the bottom of the
         Home screen only, so it never covers any button. Hidden until a
         banner actually loads, and hidden on the other screens. -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_above="@+id/bottomNav"
        android:background="@color/black_bg"
        android:visibility="gone" />

    <!-- Bottom nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/black_card"
        android:orientation="horizontal">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/black_card"
            android:text="Home"
            android:textColor="@color/gold_bright"
            android:textSize="15sp" />

        <Button
            android:id="@+id/navWalk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/black_card"
            android:text="Walk"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <Button
            android:id="@+id/navReceipts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/black_card"
            android:text="Receipts"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <Button
            android:id="@+id/navRewards"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/black_card"
            android:text="Rewards"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Test-ad overlay (test mode only) -->
    <FrameLayout
        android:id="@+id/adOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/gold"
                android:padding="8dp"
                android:text="TEST AD"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="This is a placeholder ad screen. No real advertiser is showing, and no real ad money is being earned. Real Unity ads start once the Empire Rewards Game ID is added."
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/adCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Reward in 5…"
                android:textColor="@color/gold_bright"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/adClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@color/gold"
                android:text="Collect reward"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Sign-in screen (v3): Google, email + password, or guest. Shown on
         first launch when nobody is signed in; hidden once inside the app.
         Points stay on this phone in v1 — signing in keeps your points
         separate per account; there is no cloud sync yet. -->
    <ScrollView
        android:id="@+id/screenAuth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Empire Rewards"
                android:textColor="@color/gold_bright"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Walk, snap receipts, watch ads — earn points and redeem gift cards. Sign in to keep your points with your account, or continue as a guest."
                android:textColor="@color/grey_text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnGoogle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@color/gold"
                android:text="Continue with Google"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:text="— or use email —"
                android:textColor="@color/grey_text"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/emailField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/black_card"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey_text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/passwordField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/black_card"
                android:hint="Password (at least 6 characters)"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnEmailAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/black_card"
                android:text="Create account"
                android:textColor="@color/gold_bright"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAuthMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/black_bg"
                android:text="Already have an account? Sign in"
                android:textColor="@color/grey_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@color/black_card"
                android:text="Continue without an account"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/authError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#FF6B6B"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Points stay on this phone for now — signing in keeps your points separate per account. There is no cloud sync yet, so points do not move to another phone."
                android:textColor="@color/grey_text"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
